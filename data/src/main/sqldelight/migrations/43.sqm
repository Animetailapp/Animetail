-- Remove the sync scaffolding: version, is_syncing and last_modified_at.

DROP TRIGGER IF EXISTS update_manga_version;
DROP TRIGGER IF EXISTS update_last_modified_at_mangas;
DROP TRIGGER IF EXISTS update_chapter_and_manga_version;
DROP TRIGGER IF EXISTS update_last_modified_at_chapters;
DROP TRIGGER IF EXISTS insert_manga_category_update_version;

ALTER TABLE mangas DROP COLUMN version;
ALTER TABLE mangas DROP COLUMN is_syncing;
ALTER TABLE mangas DROP COLUMN last_modified_at;

ALTER TABLE chapters DROP COLUMN version;
ALTER TABLE chapters DROP COLUMN is_syncing;
ALTER TABLE chapters DROP COLUMN last_modified_at;
