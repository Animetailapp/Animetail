CREATE TABLE category(
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    `order` INTEGER NOT NULL UNIQUE,
    flags INTEGER NOT NULL,
    hidden INTEGER NOT NULL DEFAULT 0
);

-- Insert system category
INSERT OR IGNORE INTO category(id, name, `order`, flags, hidden) VALUES (0, "", -1, 0, 0);
-- Disallow deletion of default category
CREATE TRIGGER IF NOT EXISTS system_category_delete_trigger BEFORE DELETE
ON category
BEGIN SELECT CASE
    WHEN old.id <= 0 THEN
        RAISE(ABORT, "System category can't be deleted")
    END;
END;

getCategory:
SELECT id, name, `order`, flags, hidden
FROM category
WHERE id = :id
LIMIT 1;

getCategories:
SELECT
id,
name,
`order`,
flags,
hidden
FROM category
ORDER BY `order`;

getVisibleCategories:
SELECT
id,
name,
`order`,
flags,
hidden
FROM category
WHERE hidden = 0
ORDER BY `order`;

getCategoriesByMangaId:
SELECT
C.id,
C.name,
C.`order`,
C.flags,
C.hidden
FROM category C
JOIN manga_category MC
ON C.id = MC.category_id
WHERE MC.manga_id = :mangaId
ORDER BY C.`order`;

getVisibleCategoriesByMangaId:
SELECT
C.id,
C.name,
C.`order`,
C.flags,
C.hidden
FROM category C
JOIN manga_category MC
ON C.id = MC.category_id
WHERE MC.manga_id = :mangaId AND C.hidden = 0
ORDER BY C.`order`;

insert:
INSERT INTO category(name, `order`, flags)
SELECT :name, coalesce(max(`order`), -1) + 1, :flags
FROM category;

delete:
DELETE FROM category
WHERE id = :categoryId;

updateName:
UPDATE category
SET name = :name
WHERE id = :categoryId;

getUserCategoryIds:
SELECT id
FROM category
WHERE id > 0
ORDER BY `order`;

updateOrder:
UPDATE category
SET `order` = :order
WHERE id = :categoryId;

updateFlags:
UPDATE category
SET flags = :flags
WHERE id = :categoryId;

updateHidden:
UPDATE category
SET hidden = :hidden
WHERE id = :categoryId;

updateAllFlags:
UPDATE category SET
flags = coalesce(:flags, flags);
